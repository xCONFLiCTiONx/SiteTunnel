{
  "manifest_version": 3,
  "name": "SiteTunnel",
  "version": "0.3.0",
  "description": "Country-selectable proxy switcher with per-domain proxy preferences and include/exclude rules.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "proxy",
    "storage",
    "alarms",
    "activeTab"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*",
    "https://api.ipify.org/*"
  ],
  "action": {
    "default_title": "SiteTunnel",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "111"
}