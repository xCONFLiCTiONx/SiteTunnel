{
  "manifest_version": 3,
  "name": "SiteTunnel",
  "version": "0.3.0",
  "description": "Country-selectable proxy switcher with per-domain rules and managed Tor support on Windows.",
  "permissions": [
    "proxy",
    "storage",
    "alarms",
    "activeTab",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*",
    "https://api.ipify.org/*"
  ],
  "action": {
    "default_title": "SiteTunnel",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "111"
}
