{
  "manifest_version": 3,
  "name": "SiteTunnel",
  "version": "0.3.1",
  "description": "Country-selectable proxy switcher with per-domain proxy preferences and include/exclude rules.",
  "permissions": [
    "proxy",
    "storage",
    "alarms",
    "activeTab",
    "tabs",
    "offscreen",
    "privacy",
    "notifications"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*",
    "https://api.ipify.org/*",
    "https://cloudflare.com/*",
    "https://httpbin.org/*",
    "https://api.github.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "SiteTunnel",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "111"
}
